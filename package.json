    "@sentry/nextjs": "^11.10.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "18.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-notifications-component": "^3.1.1",
